<%- include('partials/header', { title: 'Danh sách người dùng' }); %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="mb-0">Danh sách người dùng</h3>
    <div class="text-muted">Quản lý cơ bản: xem / sửa / xoá.</div>
  </div>
  <div>
    <a class="btn btn-primary" href="/crud">Thêm người dùng</a>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
  <div class="card-body p-0">
    <% if (users && users.length) { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="thead-light">
            <tr>
              <th class="pl-4">ID</th>
              <th>Email</th>
              <th>Họ tên</th>
              <th>Vai trò</th>
              <th>Điện thoại</th>
              <th>Giới tính</th>
              <th>Ngày tạo</th>
              <th class="text-right pr-4">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td class="pl-4"><%= u.id %></td>
                <td><%= u.email %></td>
                <td><%= (u.firstName || '') %> <%= (u.lastName || '') %></td>
                <td>
                  <span class="badge <%= u.role === 'admin' ? 'badge-danger' : 'badge-light border' %>">
                    <%= u.role || 'user' %>
                  </span>
                </td>
                <td><%= u.phone || '—' %></td>
                <td>
                  <% if (typeof u.gender === 'boolean') { %>
                    <%= u.gender ? 'Nam' : 'Nữ' %>
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td class="text-muted small">
                  <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('vi-VN') : '—' %>
                </td>
                <td class="text-right pr-4">
                  <a class="btn btn-sm btn-outline-secondary" href="/edit-crud?id=<%= u.id %>">Sửa</a>
                  <a class="btn btn-sm btn-outline-danger"
                     href="/delete-crud?id=<%= u.id %>"
                     onclick="return confirm('Xoá người dùng này?');">
                    Xoá
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-5 text-center text-muted">
        Chưa có dữ liệu. <a href="/crud">Tạo người dùng</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer'); %>
