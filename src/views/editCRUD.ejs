<%- include('partials/header', { title: 'Cập nhật người dùng' }); %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="mb-0">Cập nhật người dùng</h3>
    <div class="text-muted">ID: <%= user.id %></div>
  </div>
  <div>
    <a class="btn btn-outline-secondary" href="/get-crud">Quay lại danh sách</a>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
  <div class="card-body">
    <form action="/put-crud" method="POST">
      <input type="hidden" name="id" value="<%= user.id %>" />

      <div class="form-row">
        <div class="form-group col-md-6">
          <label>Email *</label>
          <input class="form-control" name="email" type="email" value="<%= user.email %>" required />
        </div>
        <div class="form-group col-md-6">
          <label>Mật khẩu (để trống nếu không đổi)</label>
          <input class="form-control" name="password" type="password" minlength="6" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-md-6">
          <label>Họ</label>
          <input class="form-control" name="firstName" type="text" value="<%= user.firstName || '' %>" />
        </div>
        <div class="form-group col-md-6">
          <label>Tên</label>
          <input class="form-control" name="lastName" type="text" value="<%= user.lastName || '' %>" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-md-8">
          <label>Địa chỉ</label>
          <input class="form-control" name="address" type="text" value="<%= user.address || '' %>" />
        </div>
        <div class="form-group col-md-4">
          <label>Giới tính</label>
          <select class="form-control" name="gender">
            <option value="" <%= typeof user.gender !== 'boolean' ? 'selected' : '' %>>—</option>
            <option value="1" <%= user.gender === true ? 'selected' : '' %>>Nam</option>
            <option value="0" <%= user.gender === false ? 'selected' : '' %>>Nữ</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-md-6">
          <label>Số điện thoại</label>
          <input class="form-control" name="phone" type="text" value="<%= user.phone || '' %>" />
        </div>
        <div class="form-group col-md-6">
          <label>Vai trò</label>
          <select class="form-control" name="role">
            <option value="user" <%= (user.role || 'user') === 'user' ? 'selected' : '' %>>user</option>
            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin</option>
          </select>
        </div>
      </div>

      <div class="d-flex justify-content-end">
        <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer'); %>
